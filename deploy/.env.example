# Vorlage für ~/server/witterung/.env – nie committen.

# Pocket ID (OIDC-Client mit Callback https://witterung.rubeen.dev/auth/callback)
WITTERUNG_OIDC_ISSUER=https://id.example.org
WITTERUNG_OIDC_CLIENT_ID=
WITTERUNG_OIDC_CLIENT_SECRET=
WITTERUNG_OIDC_ALLOWED_EMAIL=

# Mindestens 32 Zeichen, z. B. aus: openssl rand -base64 48
WITTERUNG_SESSION_SECRET=

# Wetterquellen (optional; ohne Zugang bleibt die Quelle aus).
# WeatherKit: .p8 als Datei neben die Compose-Datei (secrets/weatherkit.p8, chmod 600)
# und in docker-compose.yml einhängen, siehe README.
#WITTERUNG_WEATHERKIT_KEY_FILE=/run/secrets/weatherkit.p8
#WITTERUNG_WEATHERKIT_KEY_ID=
#WITTERUNG_WEATHERKIT_TEAM_ID=
#WITTERUNG_WEATHERKIT_SERVICE_ID=
#WITTERUNG_PIRATE_WEATHER_KEY=
